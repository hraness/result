{
  "name": "@hraness/result",
  "version": "0.2.1",
  "description": "Dependency-free Result and Option types for TypeScript. Checking ok narrows a result to its value or its declared error.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts"
  ],
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/result.git"
  },
  "homepage": "https://github.com/hraness/result#readme",
  "bugs": {
    "url": "https://github.com/hraness/result/issues"
  },
  "keywords": [
    "typescript",
    "result",
    "option",
    "error-handling",
    "discriminated-union"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "kb:search": "wordcell search --root kb --mode exact --selected-passage --rerank typesafe --rerank-limit 25",
    "kb:search:local": "wordcell search --root kb --mode exact --selected-passage",
    "build": "bun -e 'await (await import(\"node:fs/promises\")).rm(\"./dist\", { recursive: true, force: true })' && bun build ./src/index.ts --outdir ./dist --root ./src --target node --format esm --splitting --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb && bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "check": "bun run typecheck && bun run build && bun run test:package && bun run test",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@hraness/wordcell": "https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz",
    "@types/bun": "^1.3.14",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
